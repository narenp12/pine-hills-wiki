---
// Footer override for the Wikipedia skin: GitHub + Yahoo League links
// plus a "community-maintained" note, in place of Starlight's default footer.
---

<footer class="wiki-footer sl-flex">
  <div class="wiki-footer-links">
    <a href="https://github.com/narenp12/pine-hills-wiki">GitHub</a>
    <span aria-hidden="true">·</span>
    <a href="https://football.fantasysports.yahoo.com/f1/447010">Yahoo League</a>
  </div>
  <div class="wiki-footer-note">
    Community-maintained Wikipedia of the Pine Hills Fantasy Football League.
  </div>
</footer>

<style>
  .wiki-footer {
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 0;
    border-top: 1px solid var(--wiki-border);
    color: var(--wiki-muted);
    font-family: var(--wiki-font);
    font-size: 0.9rem;
  }
  .wiki-footer-links a {
    color: var(--wiki-link);
    text-decoration: none;
  }
  .wiki-footer-links a:hover {
    text-decoration: underline;
  }
  .wiki-footer-links span {
    margin: 0 0.4rem;
  }
</style>
