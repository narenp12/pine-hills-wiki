# Yahoo Fantasy Sports API credentials.
# Create a Yahoo app at https://developer.yahoo.com/apps/ (type: "Client-Side" or "Web").
# The redirect URI must be:  https://localhost:8080/  (yfpy uses this for the OAuth callback)
YAHOO_CONSUMER_KEY=your_consumer_key_here
YAHOO_CONSUMER_SECRET=your_consumer_secret_here

# Your league id (the number in the Yahoo FF URL: .../f1/<LEAGUE_ID>)
YAHOO_LEAGUE_ID=YOUR_LEAGUE_ID

# Yahoo "game id" for the CURRENT season (NFL). 449 = 2025. Find yours via:
#   python -c "from yfpy.query import YahooFantasySportsQuery; ..."
YAHOO_GAME_ID=449
